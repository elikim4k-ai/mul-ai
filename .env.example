# ── Mul gateway ──────────────────────────────────────────────
# Comma-separated caller API keys. Leave both empty for open dev mode
# (any key accepted, admin features enabled — never do this in prod).
MUL_API_KEYS=
MUL_ADMIN_KEYS=
# Optional JSON map of key -> allowed provider list (account-level pool allow-list)
# MUL_KEY_PROVIDER_ALLOW={"sk-team-a": ["upstage", "lg", "naver", "vllm"]}
MUL_KEY_PROVIDER_ALLOW=
# Requests per minute per key; 0 disables rate limiting
MUL_RATE_LIMIT_RPM=0
MUL_CONFIG_PATH=mul.config.yaml
MUL_DB_URL=sqlite:///mul_usage.db

# ── Worker provider keys (a provider without a key runs as a mock stub) ──
UPSTAGE_API_KEY=
LG_EXAONE_API_KEY=
# OpenAI-compatible endpoint serving EXAONE (e.g. FriendliAI serverless)
LG_EXAONE_BASE_URL=
NAVER_CLOVA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
